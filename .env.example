# Copy to .env and fill in values. Never commit .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=audit_platform
MYSQL_USER=audit_platform
MYSQL_PASSWORD=change-me-app

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
AUDIT_PLATFORM_DATASOURCE_URL=jdbc:mysql://localhost:3306/audit_platform
AUDIT_PLATFORM_DATASOURCE_USERNAME=audit_platform
AUDIT_PLATFORM_DATASOURCE_PASSWORD=change-me-app
AUDIT_PLATFORM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUDIT_PLATFORM_API_DOCS_ENABLED=true
AUDIT_PLATFORM_RATE_LIMIT_ENABLED=false
AUDIT_PLATFORM_RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUDIT_PLATFORM_RATE_LIMIT_PROVIDER=memory
AUDIT_PLATFORM_REDIS_URI=redis://localhost:6379

# --- Auth ---
AUDIT_PLATFORM_JWT_SECRET=change-me-in-env-jwt-secret-32b!!
AUDIT_PLATFORM_ACCESS_TOKEN_MINUTES=15
AUDIT_PLATFORM_REFRESH_TOKEN_DAYS=7
AUDIT_PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@localhost.local
AUDIT_PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin12!
AUDIT_PLATFORM_MFA_ENCRYPT_KEY=
AUDIT_PLATFORM_COOKIE_SESSIONS=false
AUDIT_PLATFORM_COOKIE_SECURE=false

# --- Object storage (local filesystem default; set provider=s3 for S3/MinIO) ---
AUDIT_PLATFORM_STORAGE_PROVIDER=local
AUDIT_PLATFORM_STORAGE_LOCAL_ROOT=
AUDIT_PLATFORM_STORAGE_S3_BUCKET=
AUDIT_PLATFORM_STORAGE_S3_REGION=us-east-1
AUDIT_PLATFORM_STORAGE_S3_ENDPOINT=

# --- Mail (logging default; smtp + MailHog profile for local SMTP) ---
AUDIT_PLATFORM_MAIL_PROVIDER=logging
AUDIT_PLATFORM_MAIL_FROM=noreply@localhost
AUDIT_PLATFORM_SMTP_HOST=
AUDIT_PLATFORM_SMTP_PORT=1025

# --- AI (stub default; vendor keys stay in the environment, never the database) ---
AUDIT_PLATFORM_AI_PROVIDER=stub
AUDIT_PLATFORM_AI_MODEL=stub-v1
AUDIT_PLATFORM_AI_PROMPT_VERSION=v1

# --- Search (mysql default; Elasticsearch query builder is not a running cluster) ---
AUDIT_PLATFORM_SEARCH_PROVIDER=mysql
AUDIT_PLATFORM_ELASTICSEARCH_URI=

# --- Notifications (scheduler dispatches due queued jobs; off in the test profile) ---
AUDIT_PLATFORM_NOTIFICATION_DISPATCH_ENABLED=true
AUDIT_PLATFORM_NOTIFICATION_DISPATCH_INTERVAL_MS=30000
AUDIT_PLATFORM_NOTIFICATION_DISPATCH_BATCH_SIZE=50

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_COOKIE_SESSIONS=false
