# Copy to .env and fill in values. Never commit .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=audit_platform
MYSQL_USER=audit_platform
MYSQL_PASSWORD=change-me-app

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
AUDIT_PLATFORM_DATASOURCE_URL=jdbc:mysql://localhost:3306/audit_platform
AUDIT_PLATFORM_DATASOURCE_USERNAME=audit_platform
AUDIT_PLATFORM_DATASOURCE_PASSWORD=change-me-app
AUDIT_PLATFORM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUDIT_PLATFORM_API_DOCS_ENABLED=true
AUDIT_PLATFORM_RATE_LIMIT_ENABLED=false
AUDIT_PLATFORM_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1
